# Public URL of the website (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://fiscalix.com

# Contact form delivery (https://resend.com — free tier is enough)
# Without RESEND_API_KEY the form still validates, but shows a WhatsApp fallback instead of sending.
RESEND_API_KEY=
# Inbox that receives project enquiries (not shown on the website)
CONTACT_TO_EMAIL=info@fiscalix.com
# Sender address — must belong to a domain verified in Resend
CONTACT_FROM_EMAIL=Fiscalix Website <website@fiscalix.com>
